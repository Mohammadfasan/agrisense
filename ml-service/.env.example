ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Absolute or relative path to the model root. Defaults to ./artifacts.
MODELS_DIR=artifacts
# Shared secret with the Node API (X-Internal-Key). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-generate-a-real-key
MAX_UPLOAD_BYTES=8388608
