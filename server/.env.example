# ---- Runtime ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Logging ----
# error | warn | info | http | debug
LOG_LEVEL=debug

# ---- MongoDB ----
# Matches the credentials in docker-compose.yml. authSource=admin is required
# because the root user is created in the `admin` database.
MONGODB_URI=mongodb://agrisense:agrisense@localhost:27017/agrisense?authSource=admin
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- HTTP ----
# Comma-separated list of allowed origins, or * for all.
CORS_ORIGIN=*
BODY_LIMIT=1mb

# ---- Shutdown ----
# Milliseconds to wait for in-flight requests before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# ---- Authentication (JWT) ----
# Required in production; a development fallback is used when unset elsewhere.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ISSUER=agrisense
JWT_AUDIENCE=agrisense-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- OTP ----
# true logs the code and returns it as `devCode` instead of sending an SMS.
# Ignored when NODE_ENV=production.
OTP_DEV_MODE=true
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_BCRYPT_ROUNDS=10
# Dialling code applied to numbers typed in local form (0771234567).
DEFAULT_PHONE_COUNTRY_CODE=+94
