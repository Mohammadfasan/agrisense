{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    // No `baseUrl`: it is deprecated in TypeScript 7, and every mapping below
    // is written relative to this file instead, which is what a path without a
    // base is resolved against.
    "paths": {
      "@config": ["./src/config/index.ts"],
      "@config/*": ["./src/config/*"],
      "@models": ["./src/models/index.ts"],
      "@models/*": ["./src/models/*"],
      "@modules": ["./src/modules/index.ts"],
      "@modules/*": ["./src/modules/*"],
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
